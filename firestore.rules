rules_version = '2';

// ============================================================
// Reglas de seguridad de Firestore para TODO el proyecto Firebase
// "aprende-y-repasa-cc321", que aloja estas apps:
//
//   - App educativa "Aprende y Repasa" (colecciones "teachers",
//     "classes", "students", "udiHistorial", "cuadernoEval"), incluida La Ciudadela
//     ("ciudadelaAvisos" y la subcolección students/*/ciudadelaDiario).
//   - App "Reunión de familias" (colecciones "reunionFamilias",
//     "reunionFamiliasSecciones", "reunionFamiliasSecret",
//     "reunionFamiliasEditores").
//   - App "Economía Familiar 2.0" (colecciones "ecoPartidas",
//     "ecoFamilias", "ecoMeses", "ecoMarcador",
//     "ecoPrestamosFamilias", "ecoEventos").
//   - Juego "Cifras y Letras" (colecciones "cylPartidas",
//     "cylJugadores", "cylRespuestas").
//   - "Novela Colectiva" (colecciones "novProyectos", "novFragmentos",
//     "novFichas", "novNotas").
//   - Juego "Letrania" (colecciones "letHeroes", "letMisiones",
//     "letConfig", "letPartidas", "letEquipos").
//
// ATENCIÓN: las reglas de Firestore son ÚNICAS por proyecto, no por
// app. Este archivo es el ÚNICO que hay que pegar en la consola
// (Firestore Database → Reglas → sustituir todo → Publicar). Pegar
// solo las reglas de una app dejaría a las demás sin acceso.
//
// Nivel de seguridad: "razonable para un aula no adversarial", no de
// nivel bancario. Los docentes tienen cuentas reales (correo + contraseña); los alumnos solo tienen una clave de
// 6+ caracteres (son menores, sin más datos).
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwnerTeacher(teacherId) {
      return signedIn() && request.auth.uid == teacherId;
    }

    // ================= App educativa =================

    match /teachers/{teacherId} {
      allow read, write: if isOwnerTeacher(teacherId);
    }

    // Cuaderno de evaluación (cuaderno-evaluacion/): notas, dificultades
    // y anotaciones del alumnado por número de lista (1-40, el mismo tope
    // que MAX_ALUMNOS en cuaderno-evaluacion/js/cuaderno.js). Solo el docente
    // dueño puede leerlo o escribirlo; nunca una sesión anónima (las del
    // alumnado), aunque el uid coincidiera.
    function esDocenteDueno(teacherId) {
      return isOwnerTeacher(teacherId)
        && request.auth.token.firebase.sign_in_provider != "anonymous";
    }

    match /cuadernoEval/{teacherId} {
      allow read, write: if esDocenteDueno(teacherId);

      match /alumnos/{n} {
        allow read, delete: if esDocenteDueno(teacherId);
        allow create, update: if esDocenteDueno(teacherId)
          && n.matches("^([1-9]|[1-3][0-9]|40)$");
      }
    }

    match /classes/{classId} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.teacherId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isOwnerTeacher(resource.data.teacherId);
    }

    // Histórico opcional del Generador de Unidad Didáctica: un registro
    // ligero por cada paquete compilado, solo visible/creable por el
    // propio docente. La herramienta funciona igual sin esta colección.
    match /udiHistorial/{entryId} {
      allow list: if signedIn() && resource.data.teacherId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.teacherId == request.auth.uid;
      allow delete: if isOwnerTeacher(resource.data.teacherId);
    }

    match /students/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.teacherId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.teacherId == request.auth.uid;
      // Cualquier sesión que conozca la clave puede reclamar al alumno,
      // y solo puede tocar authUid y lastLoginAt. Antes la clave quedaba
      // atada al primer dispositivo que la usaba, así que el mismo
      // alumno no podía entrar en clase y en casa: ahora el último
      // dispositivo desde el que entra pasa a ser el activo.
      allow update: if isOwnerTeacher(resource.data.teacherId)
                    || (signedIn()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(["authUid", "lastLoginAt"]));
      allow delete: if isOwnerTeacher(resource.data.teacherId);

      match /logins/{loginId} {
        allow create: if signedIn()
                       && get(/databases/$(database)/documents/students/$(code)).data.authUid == request.auth.uid;
        allow read: if isOwnerTeacher(get(/databases/$(database)/documents/students/$(code)).data.teacherId);
      }

      match /dailyStats/{statId} {
        allow read, write: if signedIn()
                       && get(/databases/$(database)/documents/students/$(code)).data.authUid == request.auth.uid;
        allow read: if isOwnerTeacher(get(/databases/$(database)/documents/students/$(code)).data.teacherId);
      }

      match /reviewQueue/{itemId} {
        allow read, write: if signedIn()
                       && get(/databases/$(database)/documents/students/$(code)).data.authUid == request.auth.uid;
      }

      // Aquí guarda su progreso «Chispa y la Fábrica de Robots»
      // (documento "chispa", ver pensamiento-computacional/js/nube.js),
      // que el docente ve en su panel.
      match /gamification/{doc} {
        allow read, write: if signedIn()
                       && get(/databases/$(database)/documents/students/$(code)).data.authUid == request.auth.uid;
        allow read: if isOwnerTeacher(get(/databases/$(database)/documents/students/$(code)).data.teacherId);
      }

      // Diario de La Ciudadela: SOLO el propio alumno (su dispositivo
      // activo). A propósito, sin regla de lectura para el docente: un
      // diario que lee el maestro deja de ser un diario.
      match /ciudadelaDiario/{entryId} {
        allow read, write: if signedIn()
                       && get(/databases/$(database)/documents/students/$(code)).data.authUid == request.auth.uid;
      }
    }

    // Avisos del botón «Necesito ayuda» de La Ciudadela. Los crea el
    // dispositivo activo de un alumno, con su docente y su clase tal y
    // como constan en su ficha (no puede avisar "en nombre" de otro ni
    // a otro docente). Solo los lee su docente, que puede marcarlos
    // como atendidos; el alumno no puede leerlos ni borrarlos después.
    match /ciudadelaAvisos/{avisoId} {
      function fichaAlumno() {
        return get(/databases/$(database)/documents/students/$(request.resource.data.studentCode)).data;
      }
      allow create: if signedIn()
                    && request.resource.data.studentCode is string
                    && fichaAlumno().authUid == request.auth.uid
                    && request.resource.data.teacherId == fichaAlumno().teacherId
                    && request.resource.data.classId == fichaAlumno().get("classId", "")
                    && request.resource.data.atendido == false
                    && request.resource.data.mensaje is string
                    && request.resource.data.mensaje.size() <= 500
                    && request.resource.data.keys().hasOnly(["teacherId", "classId", "studentCode", "nickname",
                         "motivo", "mensaje", "origen", "atendido", "createdAt"]);
      allow read: if signedIn() && resource.data.teacherId == request.auth.uid;
      allow update: if signedIn()
                    && resource.data.teacherId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["atendido", "atendidoAt"]);
      allow delete: if isOwnerTeacher(resource.data.teacherId);
    }

    // ================= App Reunión de familias =================
    //
    // Las familias LEEN sin iniciar sesión (el enlace es público).
    // Para ESCRIBIR hay que estar inscrito como editor: el docente
    // introduce el código de edición en la web, la app inicia una
    // sesión anónima y crea su documento en reunionFamiliasEditores;
    // esa creación solo se permite si el código coincide con el del
    // documento secreto (que nadie puede leer). La primera vez que
    // se usa la app aún no existe el secreto: el primer código que
    // se escriba lo crea y queda establecido (mismo nivel de
    // seguridad "de aula" que las claves de alumnos).

    function esEditorReunion() {
      return signedIn()
        && exists(/databases/$(database)/documents/reunionFamiliasEditores/$(request.auth.uid));
    }

    match /reunionFamilias/{docId} {
      allow read: if true;
      allow write: if esEditorReunion();
    }

    match /reunionFamiliasSecciones/{seccionId} {
      allow read: if true;
      allow write: if esEditorReunion();
    }

    match /reunionFamiliasSecret/main {
      allow read: if false;
      // "create" solo ocurre cuando el documento no existe todavía
      // (primer arranque); después, solo los editores pueden cambiarlo.
      allow create: if signedIn() && request.resource.data.code is string;
      allow update: if esEditorReunion() && request.resource.data.code is string;
      allow delete: if false;
    }

    match /reunionFamiliasEditores/{uid} {
      allow read, list: if false;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.code
             == get(/databases/$(database)/documents/reunionFamiliasSecret/main).data.code;
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ================= App Economía Familiar 2.0 =================
    //
    // Juego de aula: el docente (cuenta real) crea una partida con
    // familias; cada familia entra con un código de 6 caracteres que
    // es el ID de su documento en ecoFamilias, con el mismo esquema
    // de "reclamar el código desde una sesión anónima" que usan los
    // alumnos de Aprende y Repasa. El marcador y los préstamos entre
    // familias son escribibles por cualquier sesión identificada de
    // la clase: no contienen códigos ni datos personales, solo el
    // estado público del juego (nivel de seguridad "de aula").

    function esFamiliaReclamada(codigo) {
      return signedIn()
        && get(/databases/$(database)/documents/ecoFamilias/$(codigo)).data.authUid == request.auth.uid;
    }

    match /ecoPartidas/{partidaId} {
      // Las familias leen los datos básicos de su partida (nombre,
      // mes actual, ajustes) conociendo su ID; listar, solo el docente.
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.teacherId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isOwnerTeacher(resource.data.teacherId);
    }

    match /ecoFamilias/{codigo} {
      // "get" exige conocer el código (nadie puede listar las claves
      // de las demás familias salvo el docente de la partida).
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.teacherId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.teacherId == request.auth.uid;
      // Reclamar el código: cualquier sesión que lo conozca puede
      // apuntarse como dispositivo activo (solo authUid/lastLoginAt).
      // Jugar (escribir el estado del juego): solo el dispositivo que
      // tiene el código reclamado, o el docente propietario.
      allow update: if isOwnerTeacher(resource.data.teacherId)
                    || (signedIn()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(["authUid", "lastLoginAt"]))
                    || (signedIn() && resource.data.authUid == request.auth.uid);
      allow delete: if isOwnerTeacher(resource.data.teacherId);
    }

    match /ecoMeses/{mesId} {
      // Cada registro mensual lo lee y escribe la familia dueña (vía
      // su código reclamado) y el docente de la partida. Las demás
      // familias no ven los detalles: para comparar está ecoMarcador.
      allow get, list: if signedIn()
                        && (resource.data.teacherId == request.auth.uid
                            || esFamiliaReclamada(resource.data.familiaCodigo));
      allow create: if signedIn()
                     && (request.resource.data.teacherId == request.auth.uid
                         || esFamiliaReclamada(request.resource.data.familiaCodigo));
      allow update: if signedIn()
                     && (resource.data.teacherId == request.auth.uid
                         || esFamiliaReclamada(resource.data.familiaCodigo));
      allow delete: if isOwnerTeacher(resource.data.teacherId);
    }

    match /ecoMarcador/{partidaId} {
      // Tablón público de la partida (nombre, emoji, ahorros,
      // estrellas… de cada familia, sin códigos): lo leen todas las
      // sesiones y lo actualiza cada familia al cerrar su mes.
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /ecoPrestamosFamilias/{prestamoId} {
      // Préstamos solidarios entre familias, identificadas por su ID
      // público (nunca por su código de acceso).
      allow read, create, update: if signedIn();
      allow delete: if signedIn() && resource.data.teacherId == request.auth.uid;
    }

    match /ecoEventos/{eventoId} {
      // Eventos de la localidad (Feria, Reyes…): los define el
      // docente y los leen todas las familias de la clase.
      allow get, list: if signedIn();
      allow create: if signedIn() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isOwnerTeacher(resource.data.teacherId);
    }

    // ================= Juego Cifras y Letras =================
    //
    // Concurso en tiempo real. Dos modos: partida de aula (la crea
    // el docente con su cuenta real) y sala libre (la crea un alumno
    // desde una sesión anónima y él mismo hace de anfitrión). Los
    // jugadores entran solo con el código de 6 caracteres y un apodo,
    // sin datos personales. El estado del juego (letras sorteadas,
    // objetivo, respuestas, marcador) es público dentro de la partida:
    // nivel de seguridad "de aula", como en Economía Familiar.

    match /cylPartidas/{codigo} {
      // Leer exige conocer el código; listar, ser el docente creador.
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.teacherId == request.auth.uid;
      // Crear: cualquier sesión identificada que se apunte a sí misma
      // como anfitrión (docente en las de aula, alumno en las libres).
      allow create: if signedIn() && request.resource.data.anfitrionUid == request.auth.uid;
      // Dirigir la partida (sorteos, tiempo, cierre): solo el
      // anfitrión o el docente propietario.
      allow update, delete: if signedIn()
        && (resource.data.anfitrionUid == request.auth.uid
            || resource.data.teacherId == request.auth.uid);
    }

    match /cylJugadores/{jugadorId} {
      // El marcador es público para quien está en la partida (se
      // consulta filtrando por el código, que hay que conocer).
      allow read: if signedIn();
      // Cada dispositivo crea su propio jugador.
      allow create: if signedIn() && request.resource.data.authUid == request.auth.uid;
      // Actualizan el propio jugador (reconexión) y quien dirige la
      // partida (reparto de puntos). Nivel "de aula": cualquier
      // sesión identificada de la clase.
      allow update: if signedIn();
      allow delete: if signedIn();
    }

    match /cylRespuestas/{respuestaId} {
      // Una respuesta por jugador y ronda; las lee toda la partida
      // (para el marcador y la proyección) y las corrige quien
      // dirige. Sin datos personales: apodo, palabra y cuentas.
      allow read, create, update: if signedIn();
      allow delete: if signedIn();
    }

    // ================= Novela Colectiva =================
    //
    // Un alumno se identifica con su clave (students/{code}); la sesión
    // anónima que reclamó esa clave queda guardada en authUid, y es lo
    // que aquí comprueba esAlumno(). Así, aunque cualquiera pudiera
    // adivinar el id de un proyecto, solo puede escribir en él quien
    // tiene una clave viva del docente dueño de la novela.

    function esAlumno(code) {
      return signedIn()
             && exists(/databases/$(database)/documents/students/$(code))
             && get(/databases/$(database)/documents/students/$(code)).data.authUid == request.auth.uid;
    }

    // Campos que un alumno puede tocar del proyecto: los contadores que
    // se actualizan al publicar y el turno. Nunca los ajustes.
    function soloContadoresDeNovela() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["siguienteOrden", "numFragmentos", "numPalabras",
                         "actualizadoEn", "turnoDe", "turnoDesde"]);
    }

    match /novProyectos/{proyectoId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isOwnerTeacher(resource.data.teacherId)
                    // publicar (contadores y turno) lo hace el alumnado
                    || (signedIn() && soloContadoresDeNovela())
                    // y dar por terminada la novela, SOLO el alumno al que
                    // el docente ha autorizado expresamente para ello
                    || (esAlumno(request.resource.data.cerradaPor)
                        && resource.data.cerradorAutorizado == request.resource.data.cerradaPor
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(["estado", "escrituraAbierta", "cerradaPor", "actualizadoEn"]));
      allow delete: if isOwnerTeacher(resource.data.teacherId);
    }

    match /novFragmentos/{fragmentoId} {
      allow read: if signedIn();
      // Solo se puede publicar en nombre propio: el código del autor
      // tiene que ser el de la clave con la que se entró.
      allow create: if esAlumno(request.resource.data.autorCode)
                    && request.resource.data.texto is string
                    && request.resource.data.texto.size() < 4000;
      // El alumno solo puede corregir SU parte y solo el texto; el
      // docente dueño puede además aprobar, ocultar o reordenar.
      allow update: if isOwnerTeacher(resource.data.teacherId)
                    || (esAlumno(resource.data.autorCode)
                        && request.resource.data.autorCode == resource.data.autorCode
                        && request.resource.data.textoOriginal == resource.data.textoOriginal
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(["texto", "palabras", "editadoEn", "vecesEditado", "estado"]));
      allow delete: if isOwnerTeacher(resource.data.teacherId);
    }

    match /novFichas/{fichaId} {
      allow read: if signedIn();
      allow create: if esAlumno(request.resource.data.autorCode)
                    || isOwnerTeacher(request.resource.data.teacherId);
      allow update: if isOwnerTeacher(resource.data.teacherId)
                    || esAlumno(resource.data.autorCode);
      allow delete: if isOwnerTeacher(resource.data.teacherId);
    }

    match /novNotas/{notaId} {
      allow read: if signedIn();
      // Las indicaciones solo las escribe el docente; el alumno
      // destinatario únicamente puede marcarlas como leídas.
      allow create: if isOwnerTeacher(request.resource.data.teacherId);
      allow update: if isOwnerTeacher(resource.data.teacherId)
                    || (esAlumno(resource.data.destinatarioCode)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(["leido", "resuelto"]));
      allow delete: if isOwnerTeacher(resource.data.teacherId);
    }

    // ================= Letrania =================
    //
    // Juego de refuerzo de ATLC. El alumno entra con su clave de
    // Aprende y Repasa (esAlumno), pero solo si su docente le ha creado
    // un héroe en letHeroes/{clave} y lo ha habilitado para hoy. Sus
    // minutos de juego empiezan cuando él mismo escribe «inicio» (la
    // hora del servidor); pasados esos minutos ya no puede cambiar nada
    // de su héroe. Los puntos, la senda, la estación y el acceso solo
    // los escribe el docente. El héroe no guarda el nombre del alumno.

    function cuenta(m, k) {
      return m.get(k, 0);
    }
    function totalCartas(m) {
      return cuenta(m, "pista") + cuenta(m, "segunda") + cuenta(m, "lupa")
           + cuenta(m, "hada") + cuenta(m, "doble") + cuenta(m, "llave");
    }
    // Solo cambian estas claves del mapa de cartas recibidas.
    function recibidasIguales(viejo, nuevo, salvo) {
      return (salvo == "pista" || cuenta(nuevo, "pista") == cuenta(viejo, "pista"))
          && (salvo == "segunda" || cuenta(nuevo, "segunda") == cuenta(viejo, "segunda"))
          && (salvo == "lupa" || cuenta(nuevo, "lupa") == cuenta(viejo, "lupa"))
          && (salvo == "hada" || cuenta(nuevo, "hada") == cuenta(viejo, "hada"))
          && (salvo == "doble" || cuenta(nuevo, "doble") == cuenta(viejo, "doble"))
          && (salvo == "llave" || cuenta(nuevo, "llave") == cuenta(viejo, "llave"));
    }
    function cartasValidas(lista) {
      return lista is list && lista.size() <= 30
          && lista.toSet().difference(["pista", "segunda", "lupa", "hada", "doble", "llave"].toSet()).size() == 0;
    }

    // Récords de los juegos de recompensa: solo r1…r6, números enteros.
    function puntosValidos(m, k) {
      return m.get(k, 0) is int && m.get(k, 0) >= 0 && m.get(k, 0) <= 99999;
    }
    function recordsValidos(m) {
      return m is map && m.keys().hasOnly(["r1", "r2", "r3", "r4", "r5", "r6"])
          && puntosValidos(m, "r1") && puntosValidos(m, "r2") && puntosValidos(m, "r3")
          && puntosValidos(m, "r4") && puntosValidos(m, "r5") && puntosValidos(m, "r6");
    }

    function sesionLetraniaViva(h) {
      return h.habilitado == true
        && h.inicio is timestamp
        && request.time < h.inicio + duration.value(h.minutos, 'm');
    }

    match /letHeroes/{clave} {
      allow get: if esAlumno(clave)
                 || (signedIn() && resource.data.teacherId == request.auth.uid);
      allow list: if signedIn() && resource.data.teacherId == request.auth.uid;
      // Solo para alumnado de una clase propia del docente.
      allow create: if esDocenteDueno(request.resource.data.teacherId)
                    && get(/databases/$(database)/documents/students/$(clave)).data.teacherId == request.auth.uid;
      allow delete: if esDocenteDueno(resource.data.teacherId);
      allow update: if
        // El docente: todo, sin cambiar de dueño.
        (esDocenteDueno(resource.data.teacherId)
          && request.resource.data.teacherId == resource.data.teacherId)
        // El alumno pulsa «Entrar»: empieza a contar su tiempo. Solo una
        // vez por habilitación y solo el día que se le habilitó.
        || (esAlumno(clave)
          && resource.data.habilitado == true
          && resource.data.inicio == null
          && request.time < resource.data.habilitadoHasta
          && request.resource.data.inicio == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["inicio"]))
        // El alumno cambia su héroe mientras le queda tiempo. El nombre
        // nuevo siempre queda pendiente de que lo apruebe el docente.
        || (esAlumno(clave)
          && sesionLetraniaViva(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["retrato", "estandarte", "nombrePropuesto", "nombreEstado", "actualizadoEn"])
          && request.resource.data.retrato.matches("^(maga|explo|guard|bardo)-[1-4]$")
          && request.resource.data.estandarte is int
          && request.resource.data.estandarte >= 0 && request.resource.data.estandarte <= 5
          && request.resource.data.nombrePropuesto is string
          && request.resource.data.nombrePropuesto.size() <= 22
          && (request.resource.data.nombreEstado == resource.data.nombreEstado
              || request.resource.data.nombreEstado in ["pendiente", "sin"])
          && (request.resource.data.nombrePropuesto == resource.data.nombrePropuesto
              || request.resource.data.nombreEstado in ["pendiente", "sin"]))
        // El alumno cobra el premio del minijuego: UNA vez por sesión
        // («premio» pasa a valer lo mismo que «inicio»), de 5 a 20 XP y
        // de 0 a 2 gemas, y guarda lo que ha fallado («repaso»).
        //   La racha sube 1; cada 3 sesiones seguidas, un cofre: una carta
        //   más para regalar. Con la carta «Doble gema» (que se gasta en
        //   esta misma escritura) el premio puede llegar a 4 gemas.
        || (esAlumno(clave)
          && sesionLetraniaViva(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["xp", "gemas", "premio", "repaso", "racha", "cartas", "recibidas"])
          && resource.data.get("premio", null) != resource.data.inicio
          && request.resource.data.premio == resource.data.inicio
          && request.resource.data.xp - resource.data.xp >= 5
          && request.resource.data.xp - resource.data.xp <= 20
          && request.resource.data.repaso is list
          && request.resource.data.repaso.size() <= 30
          && request.resource.data.get("racha", 0) == resource.data.get("racha", 0) + 1
          && ((request.resource.data.get("racha", 0) % 3 == 0
                && cartasValidas(request.resource.data.get("cartas", []))
                && request.resource.data.get("cartas", []).size() == resource.data.get("cartas", []).size() + 1)
              || request.resource.data.get("cartas", []) == resource.data.get("cartas", []))
          && request.resource.data.gemas - resource.data.gemas >= 0
          && ((request.resource.data.get("recibidas", {}) == resource.data.get("recibidas", {})
                && request.resource.data.gemas - resource.data.gemas <= 2)
              || (recibidasIguales(resource.data.get("recibidas", {}), request.resource.data.get("recibidas", {}), "doble")
                && cuenta(request.resource.data.get("recibidas", {}), "doble") == cuenta(resource.data.get("recibidas", {}), "doble") - 1
                && request.resource.data.gemas - resource.data.gemas <= 4)))
        // Rondas de entrenamiento después del premio: solo «repaso».
        || (esAlumno(clave)
          && sesionLetraniaViva(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["repaso"])
          && request.resource.data.repaso is list
          && request.resource.data.repaso.size() <= 30)
        // Juego de recompensa: UNA partida con premio por sesión, después
        // de cobrar el de la prueba («arcade» pasa a valer «inicio»), de 1
        // a 5 XP y nunca gemas. Puede guardar a la vez su récord.
        || (esAlumno(clave)
          && sesionLetraniaViva(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["xp", "arcade", "records"])
          && resource.data.get("premio", null) == resource.data.inicio
          && resource.data.get("arcade", null) != resource.data.inicio
          && request.resource.data.arcade == resource.data.inicio
          && request.resource.data.xp - resource.data.xp >= 1
          && request.resource.data.xp - resource.data.xp <= 5
          && recordsValidos(request.resource.data.get("records", {})))
        // Partidas de entrenamiento del juego de recompensa: solo el récord.
        || (esAlumno(clave)
          && sesionLetraniaViva(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["records"])
          && recordsValidos(request.resource.data.records))
        // Usar una carta recibida en el juego (pista, segunda, lupa, hada):
        // se gasta exactamente una.
        || (esAlumno(clave)
          && sesionLetraniaViva(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["recibidas"])
          && totalCartas(request.resource.data.recibidas) == totalCartas(resource.data.get("recibidas", {})) - 1
          && cuenta(request.resource.data.recibidas, "pista") >= 0
          && cuenta(request.resource.data.recibidas, "segunda") >= 0
          && cuenta(request.resource.data.recibidas, "lupa") >= 0
          && cuenta(request.resource.data.recibidas, "hada") >= 0
          && cuenta(request.resource.data.recibidas, "doble") == cuenta(resource.data.get("recibidas", {}), "doble")
          && cuenta(request.resource.data.recibidas, "llave") == cuenta(resource.data.get("recibidas", {}), "llave"))
        // Llave dorada: se gasta una y abre un cofre de 10 XP.
        || (esAlumno(clave)
          && sesionLetraniaViva(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["recibidas", "xp"])
          && recibidasIguales(resource.data.get("recibidas", {}), request.resource.data.recibidas, "llave")
          && cuenta(request.resource.data.recibidas, "llave") == cuenta(resource.data.get("recibidas", {}), "llave") - 1
          && cuenta(request.resource.data.recibidas, "llave") >= 0
          && request.resource.data.xp == resource.data.xp + 10)
        // Regalar una carta: sale de las suyas y queda en «regalos» (el
        // buzón de salida) hasta que el panel del maestro la entrega al
        // compañero. Nunca escribe en el héroe de otro alumno.
        || (esAlumno(clave)
          && sesionLetraniaViva(resource.data)
          && !resource.data.get("regalosPausados", false)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["cartas", "regalos"])
          && cartasValidas(request.resource.data.cartas)
          && request.resource.data.cartas.size() == resource.data.get("cartas", []).size() - 1
          && request.resource.data.regalos is list
          && request.resource.data.regalos.size() == resource.data.get("regalos", []).size() + 1
          && request.resource.data.regalos.size() <= 10
          && resource.data.get("cartas", []).hasAny([request.resource.data.regalos[request.resource.data.regalos.size() - 1].carta]))
        // Poder de su clase: una vez por región (1-6). El Trazo mágico
        // (magos) queda pendiente para la próxima ficha que marque el maestro.
        || (esAlumno(clave)
          && sesionLetraniaViva(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["poderes", "trazo"])
          && request.resource.data.poderes is list
          && request.resource.data.poderes.size() == resource.data.get("poderes", []).size() + 1
          && request.resource.data.poderes.toSet().size() == request.resource.data.poderes.size()
          && request.resource.data.poderes.toSet().difference([1, 2, 3, 4, 5, 6].toSet()).size() == 0
          && (request.resource.data.get("trazo", false) == resource.data.get("trazo", false)
              || (request.resource.data.trazo == true && resource.data.retrato.matches("^maga-[1-4]$"))))
        // Vencer al guardián de una región: una vez por región, +15 XP.
        || (esAlumno(clave)
          && sesionLetraniaViva(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["guardianes", "xp"])
          && request.resource.data.guardianes is list
          && request.resource.data.guardianes.size() == resource.data.get("guardianes", []).size() + 1
          && request.resource.data.guardianes.toSet().size() == request.resource.data.guardianes.size()
          && request.resource.data.guardianes.toSet().difference([1, 2, 3, 4, 5, 6].toSet()).size() == 0
          && request.resource.data.xp == resource.data.xp + 15);
    }

    // Una ronda de minijuego (aciertos e ítems fallados) para el informe
    // de contenidos más fallados del maestro. La crea el alumno mientras
    // le queda tiempo de sesión; solo la lee su docente.
    match /letPartidas/{partidaId} {
      function heroeDe(clave) {
        return get(/databases/$(database)/documents/letHeroes/$(clave)).data;
      }
      allow create: if esAlumno(request.resource.data.clave)
                    && request.resource.data.teacherId == heroeDe(request.resource.data.clave).teacherId
                    && sesionLetraniaViva(heroeDe(request.resource.data.clave))
                    && request.resource.data.keys().hasOnly(["teacherId", "clave", "ficha", "senda", "plantilla",
                         "contenido", "aciertos", "total", "fallados", "palabras", "premio", "dia", "fecha"])
                    && request.resource.data.fallados is list
                    && request.resource.data.fallados.size() <= 40
                    && request.resource.data.palabras is list
                    && request.resource.data.palabras.size() <= 40;
      allow read: if signedIn() && resource.data.teacherId == request.auth.uid;
      allow delete: if esDocenteDueno(resource.data.teacherId);
    }

    // Equipos de 3-4 que forma el docente. Solo llevan lo que pueden ver
    // los compañeros: retrato, nombre de héroe YA APROBADO, senda,
    // estación y gemas, bajo un id público (heroeId), nunca la clave de
    // acceso. Los escribe solo el docente (lo mantiene su panel).
    match /letEquipos/{equipoId} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.teacherId == request.auth.uid;
      allow create: if esDocenteDueno(request.resource.data.teacherId);
      allow update: if esDocenteDueno(resource.data.teacherId)
                    && request.resource.data.teacherId == resource.data.teacherId;
      allow delete: if esDocenteDueno(resource.data.teacherId);
    }

    // Registro de las casillas de cada ficha (evaluación continua y
    // exportación). Solo el docente.
    match /letMisiones/{misionId} {
      allow read: if signedIn() && resource.data.teacherId == request.auth.uid;
      allow create, update: if esDocenteDueno(request.resource.data.teacherId);
      allow delete: if esDocenteDueno(resource.data.teacherId);
    }

    // Ajustes del docente (minutos por sesión, fecha y tamaño del
    // tesoro) y total de la Alianza. Los lee su alumnado; sin datos
    // personales.
    match /letConfig/{teacherId} {
      allow get: if signedIn();
      allow write: if esDocenteDueno(teacherId)
                   && request.resource.data.teacherId == teacherId;
    }

  }
}
